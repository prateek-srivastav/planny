# Copy to .env and fill in the keys you have.  Then check them:  uv run python scripts/check_env.py
#
# You need at least ONE LLM key (GOOGLE_API_KEY, OPENROUTER_API_KEY or GROQ_API_KEY); all three is
# best, so a spent free quota on one provider rolls over to the next. Leave the rest blank: models
# below whose key is blank are skipped automatically, so there is no need to edit the model lists.

# --- LLMs ---------------------------------------------------------------------------------
# Format: provider:model-id. Providers: openrouter, groq, google_genai (Gemini), anthropic, openai.
#
# MODEL runs the research + planner agents. It needs reliable tool calling and a long context.
# MODEL_FALLBACKS are tried in order when MODEL fails (rate limit, spent daily cap, outage), after
# its own retries. A model that fails is benched for MODEL_COOLDOWN_SECONDS so later calls skip it.
# This is how load rotates across providers inside the free limits.
#
# Ordered by itinerary quality (a planner-sized test on 11 Oct 2026: one complete 3-day plan in
# the real schema), alternating providers so an outage or spent quota on one moves straight on:
#   google_genai:gemini-3.8-flash            9/9 activities, 33s   (free tier; Google may use
#   google_genai:gemini-3.5-flash            9/9 activities, 24s    free-tier data to improve
#   google_genai:gemini-3.7-flash            8/9 activities, 65s    its products)
#   openrouter:nvidia/nemotron-3-super...    7/9 activities, 55s
#   openrouter:openrouter/free               7/9, scheduled filler, 118s
#   groq:*                                   malformed or empty plans: fine for research only,
#                                            kept last as a final resort
# Each Gemini model has its own free quota; all OpenRouter :free models share one (50/day).
# Not recommended: nemotron-3-ultra, nemotron-3.5-lightning (no structured output in 2-4 min).
MODEL=google_genai:gemini-3.8-flash
MODEL_FALLBACKS=openrouter:nvidia/nemotron-3-super-120b-a12b:free,google_genai:gemini-3.5-flash,openrouter:openrouter/free,google_genai:gemini-3.7-flash,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
# MODEL_COOLDOWN_SECONDS=300
#
# Classifier: one tiny call that decides whether a rejection is about the facts or the layout.
# Groq's free tier is plenty for this (1,000 req/day).
CLASSIFIER_MODEL=groq:openai/gpt-oss-20b

OPENROUTER_API_KEY=
GROQ_API_KEY=
# Google AI Studio key (free tier, no card): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=         # only if you use anthropic:... models
# OPENAI_API_KEY=            # only if you use openai:... models

# OpenRouter free models allow 20 requests/min and, unless you have bought >= $10 of credit,
# only 50 requests/day (account-wide, not per model). One plan is ~10-25 model calls, so that is
# only 2-4 plans a day. With >= $10 credit the cap is 1000/day and the models are still free.
# Check yours: uv run python scripts/check_env.py
#
# Optional: server-side fallback list inside OpenRouter (provider-level failover for MODEL).
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
# Client-side request caps (kept just under the free-tier limits so you rarely see a 429).
# OPENROUTER_RPM=18
# GROQ_RPM=25
# GOOGLE_RPM=10

# --- Web search ---------------------------------------------------------------------------
SEARCH_PROVIDER=exa          # exa | serper
# SEARCH_COUNTRY=            # optional fallback market (ISO code); normally derived from the traveller
EXA_API_KEY=
# SERPER_API_KEY=

# --- Persistence --------------------------------------------------------------------------
# SQLite by default (survives restarts, no infra). Set POSTGRES_URL to use Postgres instead.
SQLITE_PATH=data/checkpoints.sqlite
# POSTGRES_URL=postgresql://planner:planner@localhost:5432/planner

# --- Behaviour ----------------------------------------------------------------------------
MAX_REVISIONS=5              # reject cycles before the plan is finalized for human follow-up
RESUME_ORPHANS_ON_STARTUP=true
RETRY_INITIAL_DELAY=2.0      # seconds; backoff base for LLM/tool retries (free tiers rate-limit)
